# Archivo de ejemplo para variables de entorno del servidor
# Copia este archivo a .env y actualiza los valores

# Puerto del servidor backend
PORT=3001

# Configuración de SQL Server
DB_SERVER=poshcatsql.database.windows.net
DB_DATABASE=tareas
DB_USER=tareasUser
DB_PASSWORD=ReadOnlyPassword!
DB_ENCRYPT=true
DB_TRUST_CERTIFICATE=false
DB_CONNECTION_TIMEOUT=30000
